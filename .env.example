# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
ANTHROPIC_API_KEY=

RAG_MODEL=claude-sonnet-5-5
RAG_CHEAP_MODEL=claude-haiku-5-5
RAG_TOP_K=5
MAX_QUESTION_CHARS=500

# Demo lane: enabling rate limiting requires the Upstash REST credentials below.
RATE_LIMIT_ENABLED=0
PER_IP_PER_HOUR=20
DAILY_CAP=500
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Host port for the Compose Postgres (change if 5433 is already in use).
RAG_DB_PORT=5433
