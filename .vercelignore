# Vercel does not read .gitignore. Never upload a filled-in environment file.
/.env
/.env.*

/.venv
/.superpowers
/tests
/eval
/corpus
/docs
/.github

# Local caches, kept explicit. Vercel's built-in ignore list already drops `__pycache__`
# at any depth and `.venv`; only `/.pytest_cache`, `/.ruff_cache` and stray root `/*.pyc`
# add coverage here.
/__pycache__
/*.pyc
/.pytest_cache
/.ruff_cache
