# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
# LLM provider: "ollama" (Ollama Cloud, default) or "anthropic".
LLM_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
# Only when LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=

# Leave empty for the provider default (ollama: gpt-oss:120b / gpt-oss:20b;
# anthropic: claude-sonnet-5-5 / claude-haiku-5-5).
RAG_MODEL=
RAG_CHEAP_MODEL=
RAG_TOP_K=5
MAX_QUESTION_CHARS=500

# Demo lane: enabling rate limiting requires the Upstash REST credentials below.
RATE_LIMIT_ENABLED=0
PER_IP_PER_HOUR=20
DAILY_CAP=500
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Host ports for Compose. Uncomment and change if 5433 / 8000 are in use.
# RAG_DB_PORT=5433
# APP_PORT=8000
