# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql://rag:rag@localhost:5433/rag
# LLM provider: "ollama" (Ollama Cloud, default) or "anthropic".
LLM_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
# Only when LLM_PROVIDER=anthropic:
ANTHROPIC_API_KEY=
# Optional: enables the OpenRouter models in the fallback chain.
OPENROUTER_API_KEY=

# Leave empty for the provider default (ollama: glm-5.3-flash / glm-5.3-flash;
# anthropic: claude-sonnet-5-5 / claude-haiku-5-5).
RAG_MODEL=
RAG_CHEAP_MODEL=
# Ordered fallbacks as provider:model, tried when the primary fails. Empty uses
# the default chain; "none" disables. Entries whose provider has no key are skipped.
# RAG_FALLBACK_MODELS=ollama:deepseek-v4.1-flash:1017,openrouter:inclusionai/ling-3.2-flash:free,openrouter:nvidia/nemotron-3.5-super-vl:free
RAG_TOP_K=5
MAX_QUESTION_CHARS=500

# Demo lane: enabling rate limiting stores counters in the app's Postgres.
RATE_LIMIT_ENABLED=0
PER_IP_PER_HOUR=20
DAILY_CAP=500

# Host ports for Compose. Uncomment and change if 5433 / 8000 are in use.
# RAG_DB_PORT=5433
# APP_PORT=8000
